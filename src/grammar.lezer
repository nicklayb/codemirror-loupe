@top Query {
  Statement
}

Statement {
  Command Quantifier? Schema Parameters? WhereClause? |
  Command Quantifier? WhereClause
}

Command {
  Identifier
}

WhereClause {
  kw<"where"> Predicate
}

Predicate {
  OrPredicate
}

OrPredicate {
  AndPredicate (kw<"or"> AndPredicate)*
}

AndPredicate {
  NotPredicate (kw<"and"> NotPredicate)*
}

NotPredicate {
  kw<"not">? ComparisonPredicate
}

ComparisonPredicate {
  "(" Predicate ")" |
  FieldGroup kw<"not">? ComparisonOp Value |
  FieldGroup kw<"not">? InOp List |
  FieldGroup kw<"not">? LikeOp String |
  FieldGroup kw<"not">? Empty |
  FieldGroup
}

FieldGroup {
  FieldPath (GroupedOp FieldPath)*
}

GroupedOp {
  "|" | "&"
}

FieldPath {
  FieldPathBase FieldVariant? PathBinding?
}

FieldPathBase {
  Identifier (PathSeparator Identifier)*
}

FieldVariant {
  ":" Identifier
}

PathBinding {
  "[" PathPart ("," PathPart)* "]"
}

PathPart {
  Identifier | String
}

Schema {
  Identifier
}

Parameters {
  "{" ParameterList? "}"
}

ParameterList {
  Parameter ("," Parameter)*
}

Parameter {
  Identifier ":" (Value | Parameters)
}

Value {
  String | Sigil | NumberValue | bool<"true"> | bool<"false"> | Identifier
}

NumberValue {
  Number Multiplier?
}

List {
  "[" (Value ("," Value)*)? "]"
}

Quantifier {
  Number Range? Multiplier? |
  kw<"all">
}

Range {
  ".." Number
}

Multiplier {
  unit<"k"> | unit<"m"> | unit<"K"> | unit<"M">
}

ComparisonOp {
  "=" | "!=" | "<" | ">" | "<=" | ">="
}

InOp {
  kw<"in">
}

LikeOp {
  kw<"like">
}

PathSeparator {
  "."
}

@skip { space | Comment }

@tokens {
  space { $[ \t\n\r]+ }

  Comment { "#" ![\n]* }

  Identifier { $[a-zA-Z_]$[a-zA-Z0-9_]* }

  Number { "-"? $[0-9]+ ("." $[0-9]+)? }

  Sigil { "~" $[a-zA-Z] '"' (!["\\] | "\\" _)* '"' }

  Empty { ":empty" }

  String {
    '"' (!["\\] | "\\" _)* '"'
  }

  "(" ")" "[" "]" "{" "}"
  "=" "!=" "<" ">" "<=" ">="
  ":" "," ".." "."
  "|" "&"
}

kw<term> { @specialize[@name={term}]<Identifier, term> }

bool<term> { @specialize[@name=Boolean]<Identifier, term> }

unit<term> { @specialize[@name=Unit]<Identifier, term> }
